{
	"name": "@mewa-code/monorepo",
	"private": true,
	"packageManager": "bun@1.3.14",
	"workspaces": {
		"packages": [
			"apps/*",
			"packages/*"
		],
		"catalog": {
			"@earendil-works/pi-agent-core": "0.84.3",
			"@earendil-works/pi-ai": "0.84.3",
			"@earendil-works/pi-coding-agent": "0.84.3",
			"@fontsource-variable/geist": "5.3.0",
			"@fontsource-variable/geist-mono": "5.3.0",
			"@fontsource-variable/orbitron": "5.3.0",
			"@types/bun": "1.3.14",
			"typebox": "1.3.7",
			"typescript": "6.0.3"
		}
	},
	"type": "module",
	"scripts": {
		"build": "turbo run build",
		"dev": "bun scripts/dev.ts",
		"dev:server": "turbo run dev --filter=@mewa-code/server",
		"dev:web": "turbo run dev --filter=@mewa-code/web",
		"build:web": "turbo run build --filter=@mewa-code/web",
		"typecheck": "turbo run typecheck",
		"test": "turbo run test",
		"lint": "biome check .",
		"format": "biome check --write .",
		"prepare": "husky",
		"e2e": "bun e2e/run.ts",
		"e2e:serial": "bun e2e/run.ts --serial",
		"e2e:full": "playwright test",
		"e2e:full:headed": "playwright test --headed",
		"e2e:agent": "playwright test --grep @agent",
		"e2e:agent:headed": "playwright test --grep @agent --headed",
		"e2e:headed": "playwright test --headed",
		"e2e:ui": "playwright test --ui",
		"check:deps": "bun scripts/check-catalog.ts",
		"typography:generate": "bun --filter @mewa-code/web typography:generate",
		"typography:validate": "bun --filter @mewa-code/web typography:validate",
		"typography:check": "bun --filter @mewa-code/web typography:check",
		"colors:generate": "bun --filter @mewa-code/web colors:generate",
		"colors:check": "bun --filter @mewa-code/web colors:check"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.0",
		"@earendil-works/pi-coding-agent": "catalog:",
		"@mewa-code/contracts": "workspace:*",
		"@mewa-code/server": "workspace:*",
		"@mewa-code/shared": "workspace:*",
		"@playwright/test": "1.61.0",
		"husky": "9.1.7",
		"turbo": "2.9.18",
		"typescript": "catalog:"
	},
	"trustedDependencies": [
		"@biomejs/biome",
		"esbuild"
	]
}
