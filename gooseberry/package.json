{
	"name": "gooseberry",
	"private": true,
	"packageManager": "bun@1.4.0",
	"workspaces": {
		"packages": [
			"contracts",
			"webui"
		],
		"catalog": {
			"@fontsource-variable/geist-mono": "5.3.0",
			"@types/bun": "1.4.0",
			"typescript": "6.0.3"
		}
	},
	"type": "module",
	"scripts": {
		"build": "bun run build:go && bun run build:web",
		"build:go": "go build -trimpath -o dist/gooseberry ./cmd/gooseberry && go build -trimpath -o dist/gooseberry-browser ./cmd/gooseberry-browser",
		"dev:web": "bun --filter @gooseberry/web dev",
		"build:web": "bun --filter @gooseberry/web build",
		"typecheck": "bun --filter @gooseberry/contracts typecheck && bun --filter @gooseberry/web typecheck && tsc --noEmit -p tests/tsconfig.json",
		"test": "bun test tests && go test ./...",
		"check:filenames": "bun scripts/check-filenames.ts",
		"lint": "bun run check:filenames && biome check .",
		"format": "biome check --write .",
		"check:deps": "bun scripts/check-catalog.ts"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.0",
		"typescript": "catalog:"
	},
	"trustedDependencies": [
		"@biomejs/biome"
	],
	"overrides": {
		"nanoid": "3.3.18",
		"postcss": "8.5.26"
	}
}
