{
	"name": "@gooseberry/controller",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"bin": {
		"gooseberry": "./src/index.ts"
	},
	"scripts": {
		"dev": "bun run --watch src/index.ts",
		"build": "bun build src/index.ts --outdir dist --target bun",
		"typecheck": "tsc --noEmit",
		"test": "bun test --pass-with-no-tests"
	},
	"dependencies": {
		"@gooseberry/contracts": "workspace:*",
		"@gooseberry/server": "workspace:*",
		"@gooseberry/shared": "workspace:*"
	},
	"devDependencies": {
		"@types/bun": "catalog:",
		"typescript": "catalog:"
	}
}
