SYNARA_PORT=3773
SYNARA_AUTH_TOKEN=replace-with-a-long-random-token
# Synara binds 0.0.0.0 inside the container, while Compose publishes only to
# host loopback. Keep this enabled for direct local HTTP. If you place Synara
# behind an HTTPS reverse proxy, set SYNARA_PUBLIC_URL and disable this flag.
SYNARA_ALLOW_INSECURE_REMOTE=1
SYNARA_PUBLIC_URL=
MEWA_BROWSER_TOKEN=replace-with-a-separate-long-random-token

# One writable host directory owns controller configuration, caches, sessions,
# Synara state, and Pi state. Browser state stays on bounded tmpfs.
MEWA_STATE_PATH=./data

# Container UID/GID should match ownership of the state and workspace directories.
MEWA_UID=1000
MEWA_GID=1000

# The generic Compose file mounts one project at /workspace.
MEWA_WORKSPACE_PATH=.

BROWSER_MAX_ARTIFACT_BYTES=67108864
BROWSER_MAX_TOTAL_ARTIFACT_BYTES=268435456
BROWSER_MAX_STATE_BYTES=268435456
BROWSER_MAX_SESSIONS=16
BROWSER_COMMAND_TIMEOUT_MS=120000
TZ=Europe/Warsaw
