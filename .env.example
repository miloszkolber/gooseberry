SYNARA_PORT=3773
SYNARA_AUTH_TOKEN=replace-with-a-long-random-token
MEWA_BROWSER_TOKEN=replace-with-a-separate-long-random-token

# Container UID/GID should match ownership of the same-path bind mounts.
MEWA_UID=1000
MEWA_GID=1000

# These roots are mounted at the identical absolute path in mewa-code.
# Files inside them are accessed locally; all other paths use SFTP fallback.
MEWA_HOME_ROOT=/home/mewa
MEWA_DATA_ROOT=/data
MEWA_REPO_ROOT=/repos
MEWA_SFTP_FALLBACK=true

MEWA_SSH_HOST=host.docker.internal
MEWA_SSH_PORT=22
MEWA_SSH_USER=mewa
MEWA_SSH_SHELL=/bin/bash
# Exact OpenSSH known_hosts entry or pinned public host key line.
MEWA_SSH_KNOWN_HOST=host.example ssh-ed25519 AAAA...
MEWA_SSH_PRIVATE_KEY_FILE=./secrets/mewa_ed25519
# Only these values from Pi's command environment cross the SSH boundary.
MEWA_SSH_FORWARD_ENV=PI_SESSION_ID,PI_PROVIDER,PI_MODEL,PI_REASONING_LEVEL,CI
MEWA_SSH_MAX_OUTPUT_BYTES=4194304

BROWSER_MAX_ARTIFACT_BYTES=67108864
BROWSER_MAX_STATE_BYTES=268435456
BROWSER_COMMAND_TIMEOUT_MS=120000
TZ=Europe/Warsaw
