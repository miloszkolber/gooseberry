# Compose controller port. Keep the publish binding on loopback unless an
# authenticated private-network boundary is already in place.
MEWA_CODE_PORT=24242

# Required controller WebSocket/HTTP token. Keep it distinct from the browser token.
# This is an intentionally invalid sentinel. Replace it with at least 32 printable
# random-token characters, for example `openssl rand -hex 32`.
MEWA_CODE_TOKEN=INVALID_REPLACE_WITH_RANDOM_CONTROLLER_TOKEN

# Optional comma-separated browser Origins for trusted reverse proxies or private hosts.
# When unset, same-origin HTTP(S) requests whose Host matches the controller are allowed.
MEWA_CODE_ALLOWED_ORIGINS=

# Required independent token shared only by the controller and mewa-browser.
# This is an intentionally invalid sentinel. Replace it with a different strong token.
MEWA_BROWSER_TOKEN=INVALID_REPLACE_WITH_RANDOM_BROWSER_TOKEN

# Absolute host directory mounted at the exact same path in the controller.
MEWA_WORKSPACE_PATH=/repo

# Comma-separated absolute controller paths that are approved for projects and workspaces.
# Keep this to paths mounted above. Do not include / or controller state roots.
MEWA_MOUNT_ROOTS=/repo

# SSH execution authority. Use host.docker.internal for a host-side sshd on Linux
# when the default Compose extra_hosts entry is available.
MEWA_SSH_HOST=host.docker.internal
MEWA_SSH_USER=core
MEWA_SSH_PORT=22
MEWA_SSH_PRIVATE_KEY_FILE=./secrets/mewa_ed25519
MEWA_SSH_KNOWN_HOSTS_FILE=./secrets/known_hosts
# Optional transport bounds (seconds).
# MEWA_SSH_CONNECT_TIMEOUT_SECONDS=15
# MEWA_SSH_KEEPALIVE_INTERVAL_SECONDS=15
# MEWA_SSH_KEEPALIVE_COUNT_MAX=3
