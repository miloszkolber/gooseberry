# Compose controller port. Keep the publish binding on loopback unless an
# authenticated private-network boundary is already in place.
MEWA_CODE_PORT=24242

# Optional controller WebSocket/HTTP token. When omitted, the controller generates
# one on first start and stores it in the persistent mewa-state volume.
MEWA_CODE_TOKEN=

# Optional comma-separated browser Origins for trusted reverse proxies or private hosts.
# When unset, same-origin HTTP(S) requests whose Host matches the controller are allowed.
MEWA_CODE_ALLOWED_ORIGINS=

# Optional override for the internal controller/browser service token.
MEWA_BROWSER_TOKEN=

# Absolute host directory mounted at the exact same path in the controller.
MEWA_PROJECT_PATH=/repo

# Comma-separated absolute controller paths that are approved for project roots.
# Keep this to paths mounted above. Do not include / or controller state roots.
MEWA_MOUNT_ROOTS=/repo

# SSH execution authority. Use host.docker.internal for a host-side sshd on Linux
# when the default Compose extra_hosts entry is available.
MEWA_SSH_HOST=host.docker.internal
MEWA_SSH_USER=core
MEWA_SSH_PORT=22
MEWA_SSH_PRIVATE_KEY_FILE=./secrets/mewa_ed25519
MEWA_SSH_KNOWN_HOSTS_FILE=./secrets/known_hosts
