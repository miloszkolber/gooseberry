# Dedicated host data directory. Setup creates app and browser state inside it.
GOOSEBERRY_DATA_PATH=/absolute/path/to/gooseberry-data

# Required controller-to-Goose secret. It must match GOOSE_SERVER__SECRET_KEY.
GOOSEBERRY_GOOSE_SECRET_KEY=replace-with-a-random-goose-secret

# Optional controller login. Authentication is disabled by default.
GOOSEBERRY_AUTH_ENABLED=false
# GOOSEBERRY_TOKEN=replace-with-a-random-controller-token

# Optional trusted reverse-proxy origin used for controller origin checks and secure cookies.
# GOOSEBERRY_PUBLIC_ORIGIN=https://gooseberry.example.com

# Browser API authentication is disabled by default. When enabled, set a distinct strong token.
GOOSEBERRY_BROWSER_AUTH=false
# GOOSEBERRY_BROWSER_TOKEN=replace-with-a-random-browser-token
