# Existing host directories: app/ and browser/{artifacts,state}/, owned by UID/GID 1000.
# The browser directory is the embedded Browser module's state in the MCP host.
GOOSEBERRY_DATA_PATH=/absolute/path/to/gooseberry-data

# Must match the independently installed Goose service's GOOSE_SERVER__SECRET_KEY.
GOOSEBERRY_GOOSE_SECRET_KEY=replace-with-a-random-goose-secret

# The MCP host and the application share one strong private token. It authenticates
# the catalog, the embedded Browser module and the application's artifact proxy.
GOOSEBERRY_MCP_TOKEN=replace-with-a-random-mcp-token

# The MCP host publishes the embedded Browser module and future modules from one
# authenticated origin. Keep this token in Goose's private service environment too.
# GOOSEBERRY_MCP_URL=http://127.0.0.1:8787
# GOOSEBERRY_MCP_HOST=127.0.0.1
# GOOSEBERRY_MCP_PORT=8787
# GOOSEBERRY_MCP_PUBLIC_ORIGIN=
# GOOSEBERRY_MCP_MODULES=browser
# GOOSEBERRY_MCP_DISABLED_MODULES=

# Optional controller login; required for remote binding unless explicitly acknowledged.
GOOSEBERRY_AUTH_ENABLED=false
# GOOSEBERRY_TOKEN=replace-with-a-random-controller-token
# GOOSEBERRY_CONTROLLER_HOST=0.0.0.0
# GOOSEBERRY_ALLOW_UNAUTHENTICATED_REMOTE=false
# GOOSEBERRY_PUBLIC_ORIGIN=https://gooseberry.example.com

# Optional container ceilings. Defaults: app 1 GiB/2 CPUs/256 PIDs; MCP 2 GiB/2 CPUs/512 PIDs.
# GOOSEBERRY_MEMORY_LIMIT=1g
# GOOSEBERRY_CPU_LIMIT=2.0
# GOOSEBERRY_PIDS_LIMIT=256
# GOOSEBERRY_MCP_MEMORY_LIMIT=2g
# GOOSEBERRY_MCP_CPU_LIMIT=2.0
# GOOSEBERRY_MCP_PIDS_LIMIT=512

# Pin these to a release or sha-<revision> tag when using published images.
# GOOSEBERRY_IMAGE=ghcr.io/miloszkolber/gooseberry:sha-revision
# GOOSEBERRY_MCP_IMAGE=ghcr.io/miloszkolber/gooseberry-mcp:sha-revision
