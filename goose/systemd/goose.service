[Unit]
Description=Gooseberry Goose API server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/goose serve --host 127.0.0.1 --port 3284 --enable-scheduler
# Keep this static: systemd expands %h but does not inherit an interactive shell's XDG_CONFIG_HOME.
EnvironmentFile=%h/.config/goose/gooseberry.env
Environment=HOME=%h
WorkingDirectory=%h
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target

# User service install (run as the technical host user, never root). Run setup-deployment.sh first:
# install -Dm644 goose.service ~/.config/systemd/user/goose.service
# systemctl --user daemon-reload && systemctl --user enable --now goose.service
